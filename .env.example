# Server
HOST=0.0.0.0
PORT=00000

# Dashboard login (protects the training controls).
# Change both before exposing this publicly.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# External inference API key.
# Clients send it as: x-api-key: <MODEL_API_KEY>
# or: Authorization: Bearer <MODEL_API_KEY>
MODEL_API_KEY=change-this-api-key

# Allowed browser origin for the inference API.
# Use a specific origin instead of * for a public deployment.
API_CORS_ORIGIN=*

# Model branding (shown in the dashboard, API responses, and PWA manifest)
MODEL_NAME=ZarKos Mini v1
MODEL_ID=tuzhi/zarkos-mini-v1
MODEL_OWNER=TuZhi Codes
MODEL_BRAND=TuZhi Studio

# Default mode when no CLI argument is given (serve/train/chat/eval)
START_MODE=serve

# Data and checkpoints
DATA_DIR=./data
CHECKPOINT_DIR=./checkpoint
CHECKPOINT_EVERY=100

# Model architecture
VOCAB_SIZE=8000
CONTEXT_LENGTH=128
N_EMBD=256
N_HEAD=8
N_LAYER=6
FFN_HIDDEN=1024

# Training
BATCH_SIZE=2
EPOCHS=5
LEARNING_RATE=0.0005
VAL_FRACTION=0.05

